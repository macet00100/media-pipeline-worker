# ==============================================================================
# HỆ THỐNG TỰ ĐỘNG HÓA SẢN XUẤT VIDEO COOL MÈO PHIM (@CoolMeoPhim)
# Lưu ý: Không bao giờ commit file .env chứa giá trị thật lên Git!
# ==============================================================================

# 1. Khóa an toàn xuất bản (BẮT BUỘC: false để chỉ xuất Gói Xét Duyệt 3 phần)
AUTO_PUBLISH=false
MAX_VIDEOS_PER_RUN=1
JOB_TIMEOUT_MINUTES=45

# 2. Khóa API Google Gemini (Hỗ trợ nhiều key cách nhau bằng dấu phẩy để tự xoay vòng)
GEMINI_API_KEYS=your_gemini_api_key_1,your_gemini_api_key_2
GEMINI_API_KEY=your_gemini_api_key_1

# 3. Kết nối Kho phim vi kịch Trung Quốc (Điền URL API MacCMS của bạn)
LZ_API_URL=https://your-maccms-lz-api.example/api.php/provide/vod/?ac=detail&t=46&pagesize=20
FF_API_URL=https://your-maccms-ff-api.example/api.php/provide/vod/?ac=detail&t=36&pagesize=20
HTTP_PROXY=

# 4. Thông báo Telegram khi hoàn thành Gói Xét Duyệt (Tùy chọn)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# 5. Thông tin YouTube API (Giữ sẵn cho PublisherStub khi mở khóa sau này)
YT_CLIENT_ID=
YT_CLIENT_SECRET=
YT_REFRESH_TOKEN=

# 6. Thông tin Facebook Page API (Giữ sẵn cho PublisherStub khi mở khóa sau này)
FB_PAGE_ID=
FB_ACCESS_TOKEN=
